        "connect_timeout": "5s",
        "per_connection_buffer_limit_bytes": 262144,
        "circuit_breakers": {
          "thresholds": [
            {
              "max_connections": 64,
              "max_pending_requests": 64,
              "max_requests": 256
            }
          ]
        },
        "load_assignment": {
          "cluster_name": "webtransport_upstream",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "app.internal",
                        "port_value": 9443
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "typed_extension_protocol_options": {
          "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
            "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
            "explicit_http_config": {
              "http3_protocol_options": {
                "allow_extended_connect": true,
                "quic_protocol_options": {
                  "max_concurrent_streams": 100,
                  "initial_stream_window_size": 262144,
                  "initial_connection_window_size": 4194304,
                  "connection_keepalive": {
                    "initial_interval": "5s",
                    "max_interval": "15s"
                  }
                }
              }
            },
            "common_http_protocol_options": {
              "max_requests_per_connection": 1
            }
          }
        },
        "transport_socket": {
          "name": "envoy.transport_sockets.quic",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.transport_sockets.quic.v3.QuicUpstreamTransport",
            "upstream_tls_context": {
              "sni": "app.internal",
              "common_tls_context": {
                "alpn_protocols": [
                  "h3"
                ],
                "tls_params": {
                  "tls_minimum_protocol_version": "TLSv1_3"
                },
                "validation_context": {
                  "trusted_ca": {
                    "filename": "/pki/upstream-ca.pem"
                  },
                  "match_typed_subject_alt_names": [
                    {
                      "san_type": "DNS",
                      "matcher": {
                        "exact": "app.internal"
                      }
                    }
                  ]
                },
                "tls_certificates": [
                  {
                    "certificate_chain": {
                      "filename": "/pki/gateway.crt"
                    },
                    "private_key": {
                      "filename": "/pki/gateway.key"
                    }
                  }
                ]
              }
            }
          }
        },
        "cluster_type": {
          "name": "envoy.clusters.dns",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster",
            "dns_refresh_rate": "5s",
            "dns_failure_refresh_rate": {
              "base_interval": "1s",
              "max_interval": "5s"
            },
            "respect_dns_ttl": false
          }
        }
      }
    ]
  },
  "overload_manager": {
    "resource_monitors": [
      {
        "name": "envoy.resource_monitors.global_downstream_max_connections",
        "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.resource_monitors.downstream_connections.v3.DownstreamConnectionsConfig",
          "max_active_downstream_connections": 10000
        }
      }
    ]
  },
  "admin": {
    "address": {
      "pipe": {
        "path": "/tmp/envoy-admin.sock"
      }
    }
  },
  "layered_runtime": {
    "layers": [
      {
        "name": "openzta_protocol_defaults",
        "static_layer": {
          "envoy.reloadable_features.enable_universal_header_validator": true,
          "envoy.reloadable_features.quic_support_web_transport": true
        }
      }
    ]
  }
}
