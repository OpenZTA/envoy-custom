   // Transform H/2 extended CONNECT to H/1 UPGRADE, so that request processing always observes H/1
   // UPGRADE requests
   if (::Envoy::Http::Utility::isH2UpgradeRequest(header_map)) {
+    // RFC 8441/9220 omit the RFC 6455 challenge. Supply a fresh nonce only
+    // when translating an extended WebSocket CONNECT for an HTTP/1 backend.
+    const ::Envoy::Http::LowerCaseString websocket_key("sec-websocket-key");
+    if (absl::EqualsIgnoreCase(header_map.getProtocolValue(), "websocket") &&
+        header_map.get(websocket_key).empty()) {
+      std::array<uint8_t, 16> nonce;
+      RELEASE_ASSERT(RAND_bytes(nonce.data(), nonce.size()) == 1, "WebSocket nonce generation");
+      header_map.setCopy(websocket_key, ::Envoy::Base64::encode(
+          reinterpret_cast<const char*>(nonce.data()), nonce.size()));
+    }
     ::Envoy::Http::Utility::transformUpgradeRequestFromH2toH1(header_map);
   }
   return ::Envoy::Http::ServerHeaderValidator::RequestHeadersTransformationResult::success();
@@ -563,6 +576,10 @@
     ::Envoy::Http::ResponseHeaderMapPtr modified_headers =
         ::Envoy::Http::createHeaderMap<::Envoy::Http::ResponseHeaderMapImpl>(header_map);
     ::Envoy::Http::Utility::transformUpgradeResponseFromH1toH2(*modified_headers);
+    // RFC 8441/9220 do not carry the HTTP/1 challenge response to the client.
+    if (absl::EqualsIgnoreCase(header_map.getUpgradeValue(), "websocket")) {
+      modified_headers->remove(::Envoy::Http::LowerCaseString("sec-websocket-accept"));
+    }
     // Return new header map along with the success result
     return {RejectResult::success(), std::move(modified_headers)};
   }
