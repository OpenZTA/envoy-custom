+class ClientProofDetails : public quic::ProofVerifyDetails {
+public:
+  explicit ClientProofDetails(std::vector<std::string> chain) : chain_(std::move(chain)) {}
+  ProofVerifyDetails* Clone() const override { return new ClientProofDetails(chain_); }
+  std::vector<std::string> chain_;
+};
+class ClientValidationCallback : public Ssl::ValidateResultCallback {
+public:
+  ClientValidationCallback(Event::Dispatcher& dispatcher,
+                           std::unique_ptr<quic::ProofVerifierCallback> callback,
+                           std::vector<std::string> chain, Ssl::ServerContextSharedPtr context)
+      : dispatcher_(dispatcher), callback_(std::move(callback)), chain_(std::move(chain)),
+        context_(std::move(context)) {}
+  Event::Dispatcher& dispatcher() override { return dispatcher_; }
+  void onCertValidationResult(bool succeeded, Ssl::ClientValidationStatus status,
+                              const std::string& error, uint8_t) override {
+    const bool validated = succeeded && status == Ssl::ClientValidationStatus::Validated;
+    std::unique_ptr<quic::ProofVerifyDetails> details = validated
+        ? std::make_unique<ClientProofDetails>(chain_) : nullptr;
+    callback_->Run(validated, error, &details);
+  }
+private:
+  Event::Dispatcher& dispatcher_;
+  std::unique_ptr<quic::ProofVerifierCallback> callback_;
+  std::vector<std::string> chain_;
+  Ssl::ServerContextSharedPtr context_;
+};
+// QUICHE's default verifier accepts every client certificate when no verifier is
+// installed. Always route verification to Envoy's configured TLS validator.
+class OpenZtaServerHandshaker : public quic::TlsServerHandshaker {
+public:
+  OpenZtaServerHandshaker(quic::QuicSession* session,
+                          const quic::QuicCryptoServerConfig* config, Event::Dispatcher& dispatcher)
+      : quic::TlsServerHandshaker(session, config), session_(*session),
+        proof_source_(dynamic_cast<EnvoyQuicProofSource*>(config->proof_source())),
+        dispatcher_(dispatcher) {
+    // A resumed connection must never inherit another connection's identity.
+    RELEASE_ASSERT(DisableResumption(), "disable QUIC client authentication resumption");
+  }
+protected:
+  void OnSelectCertificateDone(bool ok, bool is_sync, SSLConfig config,
+                               absl::string_view key, bool matched_sni) override {
+    auto selected = proof_source_ == nullptr ? absl::nullopt :
+        proof_source_->clientValidationContext(session_.connection()->self_address(),
+            session_.connection()->peer_address(), crypto_negotiated_params().sni);
+    if (!selected.has_value() || !selected->second) {
+      ok = false;
+    } else {
+      context_ = selected->second;
+      std::visit([&](auto& value) { value.delayed_ssl_config.client_cert_mode =
+          selected->first ? quic::ClientCertMode::kRequire : quic::ClientCertMode::kNone; }, config);
+    }
+    quic::TlsServerHandshaker::OnSelectCertificateDone(ok, is_sync, std::move(config), key, matched_sni);
+  }
+  quic::QuicAsyncStatus VerifyCertChain(const std::vector<std::string>& certs,
+      std::string* error, std::unique_ptr<quic::ProofVerifyDetails>* details,
+      uint8_t* alert, std::unique_ptr<quic::ProofVerifierCallback> callback) override {
+    auto* context = dynamic_cast<Extensions::TransportSockets::Tls::ServerContextImpl*>(context_.get());
+    if (context == nullptr || certs.empty()) { *error = "missing QUIC client validation context"; return quic::QUIC_FAILURE; }
+    bssl::UniquePtr<STACK_OF(X509)> chain(sk_X509_new_null());
+    for (const auto& der : certs) {
+      auto cert = parseDERCertificate(der, error);
+      if (!cert || !bssl::PushToStack(chain.get(), std::move(cert))) { return quic::QUIC_FAILURE; }
+    }
+    auto result = context->customVerifyCertChainForQuic(*chain,
+        std::make_unique<ClientValidationCallback>(dispatcher_, std::move(callback), certs, context_),
+        true, nullptr, {nullptr}, "");
+    using Results = Extensions::TransportSockets::Tls::ValidationResults;
+    if (result.status == Results::ValidationStatus::Pending) { return quic::QUIC_PENDING; }
+    if (result.status == Results::ValidationStatus::Successful &&
+        result.detailed_status == Ssl::ClientValidationStatus::Validated) {
+      *details = std::make_unique<ClientProofDetails>(certs); return quic::QUIC_SUCCESS;
+    }
+    *error = result.error_details.value_or("QUIC client certificate not validated");
+    *alert = result.tls_alert.value_or(SSL_AD_BAD_CERTIFICATE);
+    return quic::QUIC_FAILURE;
+  }
+  void OnProofVerifyDetailsAvailable(const quic::ProofVerifyDetails& details) override {
+    auto* session = dynamic_cast<EnvoyQuicServerSession*>(&session_);
+    auto* proof = dynamic_cast<const ClientProofDetails*>(&details);
+    if (session != nullptr && proof != nullptr) { session->onClientCertificateValidated(proof->chain_); }
+  }
+private:
+  quic::QuicSession& session_;
+  EnvoyQuicProofSource* proof_source_;
+  Event::Dispatcher& dispatcher_;
+  Ssl::ServerContextSharedPtr context_;
+};
