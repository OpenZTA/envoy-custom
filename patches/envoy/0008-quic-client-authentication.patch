+namespace Envoy { namespace Quic {
+void QuicSslConnectionInfo::setVerifiedPeerChain(const std::vector<std::string>& chain) {
+  using namespace Extensions::TransportSockets::Tls;
+  if (chain.empty()) { return; }
+  auto fingerprint = [](X509* cert, const EVP_MD* md) {
+    unsigned int n = 0; unsigned char bytes[EVP_MAX_MD_SIZE];
+    RELEASE_ASSERT(X509_digest(cert, md, bytes, &n) == 1, "certificate digest");
+    return Hex::encode(bytes, n);
+  };
+  for (size_t i = 0; i < chain.size(); ++i) {
+    const auto* der = reinterpret_cast<const uint8_t*>(chain[i].data());
+    bssl::UniquePtr<X509> cert(d2i_X509(nullptr, &der, chain[i].size()));
+    RELEASE_ASSERT(cert != nullptr, "previously validated DER certificate");
+    bssl::UniquePtr<BIO> bio(BIO_new(BIO_s_mem()));
+    RELEASE_ASSERT(PEM_write_bio_X509(bio.get(), cert.get()) == 1, "certificate PEM");
+    const uint8_t* data; size_t length;
+    RELEASE_ASSERT(BIO_mem_contents(bio.get(), &data, &length) == 1, "certificate PEM buffer");
+    auto pem = Http::Utility::PercentEncoding::urlEncode(
+        absl::string_view(reinterpret_cast<const char*>(data), length));
+    peer_chain_ += pem;
+    chain_sha256_.push_back(fingerprint(cert.get(), EVP_sha256()));
+    chain_sha1_.push_back(fingerprint(cert.get(), EVP_sha1()));
+    if (i == 0) {
+      peer_pem_ = pem; peer_sha256_ = chain_sha256_.back(); peer_sha1_ = chain_sha1_.back();
+      peer_serial_ = Utility::getSerialNumberFromCertificate(*cert);
+      peer_issuer_ = Utility::getIssuerFromCertificate(*cert);
+      peer_subject_ = Utility::getSubjectFromCertificate(*cert);
+      peer_parsed_ = Utility::parseSubjectFromCertificate(*cert);
+      peer_uri_ = Utility::getSubjectAltNames(*cert, GEN_URI);
+      peer_dns_ = Utility::getSubjectAltNames(*cert, GEN_DNS);
+      peer_ip_ = Utility::getSubjectAltNames(*cert, GEN_IPADD);
+      peer_email_ = Utility::getSubjectAltNames(*cert, GEN_EMAIL);
+      peer_other_ = Utility::getSubjectAltNames(*cert, GEN_OTHERNAME);
+      peer_oids_ = Utility::getCertificateExtensionOids(*cert);
+      peer_from_ = Utility::getValidFrom(*cert); peer_until_ = Utility::getExpirationTime(*cert);
+    }
+  }
+  cert_validated_ = true;
+}
+} }
