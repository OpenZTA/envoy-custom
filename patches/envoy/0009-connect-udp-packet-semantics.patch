+// Apply downstream HTTP flow control to the UDP socket. The kernel's bounded
+// datagram queue may drop packets while paused; userspace must not grow without
+// bound when an HTTP client stops consuming the encapsulated response.
+void UdpUpstream::readDisable(bool disable) {
+  if (!socket_->isOpen()) {
+    return;
+  }
+  if (disable) {
+    ++read_disable_count_;
+  } else if (read_disable_count_ > 0) {
+    --read_disable_count_;
+  } else {
+    return;
+  }
+  const uint32_t events = read_disable_count_ == 0
+      ? static_cast<uint32_t>(Event::FileReadyType::Read) : 0;
+  socket_->ioHandle().enableFileEvents(events);
+  if (read_disable_count_ == 0) {
+    socket_->ioHandle().activateFileEvents(Event::FileReadyType::Read);
+  }
+}
