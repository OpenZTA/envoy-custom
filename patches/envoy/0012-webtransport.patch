+  auto* tls_context = dynamic_cast<Extensions::TransportSockets::Tls::ContextImpl*>(context.get());
+  if (tls_context == nullptr) {
+    return absl::InvalidArgumentError("QUIC client identity requires an Envoy TLS context");
+  }
+  const Network::TransportSocketOptionsConstSharedPtr options;
+  auto ssl = tls_context->newSsl(options, nullptr);
+  RETURN_IF_NOT_OK(ssl.status());
+  X509* leaf = SSL_get_certificate(ssl->get());
+  EVP_PKEY* key = SSL_get_privatekey(ssl->get());
+  if (leaf == nullptr || key == nullptr) {
+    return absl::InvalidArgumentError(
+        "QUIC client service certificate or software key unavailable");
+  }
+  std::vector<bssl::UniquePtr<CRYPTO_BUFFER>> owned_chain;
+  std::vector<CRYPTO_BUFFER*> chain;
+  auto append = [&](X509* certificate) -> bool {
+    const int length = i2d_X509(certificate, nullptr);
+    if (length <= 0) {
+      return false;
+    }
+    std::vector<uint8_t> der(length);
+    unsigned char* cursor = der.data();
+    if (i2d_X509(certificate, &cursor) != length) {
+      return false;
+    }
+    bssl::UniquePtr<CRYPTO_BUFFER> buffer(CRYPTO_BUFFER_new(der.data(), der.size(), nullptr));
+    if (buffer == nullptr) {
+      return false;
+    }
+    chain.push_back(buffer.get());
+    owned_chain.push_back(std::move(buffer));
+    return true;
+  };
+  if (!append(leaf)) {
+    return absl::InvalidArgumentError("QUIC service certificate encoding failed");
+  }
+  STACK_OF(X509)* extra_chain = nullptr;
+  SSL_get0_chain_certs(ssl->get(), &extra_chain);
+  for (size_t i = 0; i < sk_X509_num(extra_chain); ++i) {
+    if (!append(sk_X509_value(extra_chain, i))) {
+      return absl::InvalidArgumentError("QUIC service certificate chain encoding failed");
+    }
+  }
+  // BoringSSL retains references. No private key bytes are serialized or exported.
+  if (SSL_CTX_set_chain_and_key(quic_ctx, chain.data(), chain.size(), key, nullptr) != 1) {
+    return absl::InvalidArgumentError("QUIC service identity installation failed");
+  }
+  SSL_CTX_set_early_data_enabled(quic_ctx, 0);
+  SSL_CTX_set_session_cache_mode(quic_ctx, SSL_SESS_CACHE_OFF);
+  return absl::OkStatus();
+}
