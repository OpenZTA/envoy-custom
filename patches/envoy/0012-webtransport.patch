+bool WebTransportSessionState::active() const {
+  if (!downstreamAlive() || !upstreamAlive() ||
+      (downstream_allowed && !*downstream_allowed) ||
+      (upstream_allowed && !*upstream_allowed)) {
+    return false;
+  }
+  // A connection is marked closed before QUICHE notifies each stream. A
+  // child callback may run before its parent receives OnConnectionClosed().
+  // Check both connections rather than relying only on parent visitor state.
+  auto* downstream = dynamic_cast<quic::QuicSpdyStream*>(downstream_transport);
+  auto* upstream = dynamic_cast<quic::QuicSpdyStream*>(upstream_transport);
+  return (downstream == nullptr || downstream->spdy_session()->connection()->connected()) &&
+         (upstream == nullptr || upstream->spdy_session()->connection()->connected());
+}
