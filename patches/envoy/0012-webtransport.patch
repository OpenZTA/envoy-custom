+    // but a stream pointer must not be used again after either parent has closed.
+    if (local_ == nullptr || peer_ == nullptr || !active_()) {
+      return true;
+    }
+    if (result.bytes_read == 0 && !result.fin) {
+      // Nothing more to read right now.
+      return true;
+    }
