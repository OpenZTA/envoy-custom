+                                 public std::enable_shared_from_this<WebTransportStreamBridge> {
+public:
+  WebTransportStreamBridge(
+      webtransport::Stream* local, webtransport::Stream* peer,
+      std::function<bool()> active = []() { return true; },
+      quic::QuicSpdySession* local_session = nullptr,
+      quic::QuicSpdySession* peer_session = nullptr);
